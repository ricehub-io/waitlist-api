# Optional, default: 3000
PORT="3000"

# Required, PostgreSQL connection URL
# Format: postgres://username:password@hostname/db_name
DATABASE_URL=""

# Allowed origin for CORS requests (typically the frontend URL).
# Optional, default: http://127.0.0.1:5173
CORS_ORIGIN="http://127.0.0.1:5173"

# Required, base URL of the S3-compatible object storage (e.g. http://127.0.0.1:9000)
S3_BASE_URL=""

# Required, name of the bucket used for storing media files
S3_MEDIA_BUCKET=""

# Required, access key for the S3-compatible object storage
S3_ACCESS_KEY=""

# Required, secret key for the S3-compatible object storage
S3_SECRET_KEY=""

# Required, used for auth in admin-only endpoints (e.g. create preview rice).
# Generate using: openssl rand -hex 32
ADMIN_SECRET=""

# Max form submissions per IP per minute for public endpoints (CreateWaitlistEmail, CreateFoundingCreator).
# Optional, default: 5
RATE_LIMIT_PER_MINUTE="5"

# Max burst of requests allowed before rate limiting kicks in.
# Optional, default: 3
RATE_LIMIT_BURST="3"