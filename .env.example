# In which environment is the app running.
# Optional. Default: dev
#
# Valid values:
#   - "dev"
#   - "prod"
ENVIRONMENT="dev"

# Address on which the REST API should be available.
# Optional. Default: 127.0.0.1:3000
BIND_ADDRESS="127.0.0.1:3000"

# Connection string to the running PostgreSQL database.
# Required.
#
# Valid formats: 
#   - "postgres://username:password@127.0.0.1/my_db"
#   - "host=127.0.0.1 port=5432 dbname=my_db user=username password=password"
DATABASE_URL=""

# Allowed origin for CORS requests (typically the frontend URL).
# Optional. No origin allowed if empty.
# Example: http://127.0.0.1:5173
CORS_ORIGIN=""

# Base URL of the S3-compatible object storage.
# Required. Example: http://127.0.0.1:9000
S3_BASE_URL=""

# Name of the bucket used for storing media files.
# Required.
#
# NOTE: The bucket should be publicly accessible for the returned thumbnail URLs to work.
S3_MEDIA_BUCKET=""

# Access key for the S3-compatible object storage.
# Required.
S3_ACCESS_KEY=""

# Secret key for the S3-compatible object storage.
# Required.
S3_SECRET_KEY=""

# Secret used for auth in admin-only endpoints (e.g. create preview rice).
# Required.
#
# You can generate it using: `openssl rand -hex 32`.
ADMIN_SECRET=""

# Max form submissions per IP per minute for public endpoints (CreateWaitlistEmail, CreateFoundingCreator).
# Optional. Default: 5.
RATE_LIMIT_PER_MINUTE="5"

# Max burst of requests allowed before rate limiting kicks in.
# Optional. Default: 3.
RATE_LIMIT_BURST="3"

# URL of the discord webhook where notifications (e.g. user applied as a founding creator) should be sent.
# Optional. Discord notifications disabled if empty.
DISCORD_WEBHOOK_URL=""